---
import { site } from '../lib/site';
import { withBase } from '../lib/path';
import { getProjects } from '../lib/projects';
import { getTools } from '../lib/tools';
import { profile } from '../lib/profile';
import { resumeReady } from '../lib/resume';
import meta from '../data/ca-terrain.json';

/**
 * Arrival. The Living Atlas (a fixed WebGL California, mounted in BaseLayout)
 * IS the hero — this section is transparent and stays out of its way: the
 * name and the readouts sit low-left, the state fills the rest of the frame,
 * and an instrument HUD in the corner reports what the camera is looking at.
 */
const projects = await getProjects();
const tools = await getTools();
const active = projects.filter((p) => p.data.status === 'active');
const located = projects.filter((p) => p.data.lat && p.data.lng);

// Licensure line from profile.json: "<current credential> → <in-progress one>".
const held = profile.credentials.find((c) => /active|held|licensed/i.test(c.status));
const pending = profile.credentials.find((c) => /progress|pending|anticipated/i.test(c.status));
const abbrev = (label: string) => label.match(/\(([^)]+)\)/)?.[1] ?? label;
const licensureLine = held && pending
  ? `${abbrev(held.label)} → ${abbrev(pending.label)} ${pending.date.toLowerCase()}`
  : held
    ? `${abbrev(held.label)} · ${held.issuer}`
    : null;

const statusLines = [
  active[0] ? `${active[0].data.title} — active` : null,
  licensureLine,
  tools.length > 0 ? `${tools.length} field tool${tools.length === 1 ? '' : 's'} shipped` : null,
  `${projects.length} project${projects.length === 1 ? '' : 's'} documented`,
].filter(Boolean) as string[];

const pad = (n: number) => String(n).padStart(2, '0');
---
<section class="hero" aria-label="Introduction" data-hero>
  <div class="hero__inner u-container" data-hero-parallax="content">
    <p class="hero__eyebrow" data-hero-fade>{site.credential} · {site.location.split(',')[0]}</p>
    <h1 class="hero__title" data-hero-title>{site.heroTitle || site.name}</h1>
    <p class="hero__sub" data-hero-fade>{site.role}</p>

    {statusLines.length > 0 && (
      <div class="hero__status u-mono" data-hero-fade data-status-rotator aria-live="off">
        <span class="hero__status-key" aria-hidden="true">NOW</span>
        <span class="hero__status-line" data-status-lines={JSON.stringify(statusLines)}>{statusLines[0]}</span>
      </div>
    )}

    <div class="hero__cta" data-hero-fade>
      {resumeReady ? (
        <>
          <a href={withBase(site.resume)} class="btn" data-magnetic="0.4" download>Download résumé</a>
          <a href={withBase('#atlas')} class="btn btn--ghost" data-magnetic="0.4">Explore the atlas</a>
        </>
      ) : (
        <>
          <a href={withBase('#atlas')} class="btn" data-magnetic="0.4">Explore the atlas</a>
          <a href={withBase('#contact')} class="btn btn--ghost" data-magnetic="0.4">Request résumé</a>
        </>
      )}
    </div>

    <p class="hero__avail u-mono" data-hero-fade>
      <span class="hero__avail-dot" aria-hidden="true"></span>Open to remediation roles across California
    </p>
  </div>

  <!-- Instrument HUD: what the camera is looking at, live. -->
  <aside class="hud u-mono" data-hero-fade aria-label="Atlas readout">
    <div class="hud__row"><span class="hud__k">TARGET</span><span class="hud__v"><span data-hud-lat>37.00° N</span> <span data-hud-lng>120.00° W</span></span></div>
    <div class="hud__row"><span class="hud__k">SITES</span><span class="hud__v">{pad(located.length)} mapped · {pad(active.length)} active</span></div>
    <div class="hud__row"><span class="hud__k">RELIEF</span><span class="hud__v">0 – {meta.metersMax.toLocaleString()} m · SRTM</span></div>
    <div class="hud__row hud__row--scroll"><span class="hud__k">SCROLL</span><span class="hud__v"><span class="hud__bar" aria-hidden="true"></span></span></div>
  </aside>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    /* transparent by design — the Living Atlas shows through */
    display: grid;
    align-items: end;
    padding-bottom: clamp(3rem, 9vh, 6.5rem);
    padding-top: 6rem;
  }
  .hero__inner {
    position: relative;
    z-index: 2;
    width: min(100% - 2.5rem, 80rem);
    max-width: 100%;
  }
  .hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.8em;
    color: var(--color-field-bright);
    letter-spacing: 0.24em;
    text-transform: uppercase;
    font-size: var(--text-sm);
    margin-bottom: 1.2rem;
    opacity: 0;
  }
  .hero__eyebrow::before {
    content: '';
    width: 2.2rem;
    height: 1px;
    background: var(--color-field-bright);
    opacity: 0.7;
  }
  .hero__title {
    font-size: clamp(2.6rem, 1rem + 6.2vw, 6.4rem);
    letter-spacing: -0.035em;
    line-height: 0.96;
    opacity: 0; /* revealed by SplitText (or instantly under reduced-motion) */
    max-width: 12ch;
    overflow-wrap: break-word;
    text-wrap: balance;
    /* the name reads over the moving field without a slab behind it */
    text-shadow: 0 2px 24px color-mix(in srgb, var(--color-ink) 70%, transparent);
  }
  @media (max-width: 520px) {
    .hero__title { max-width: 100%; }
  }
  .hero__sub {
    margin-top: 1.4rem;
    max-width: 42ch;
    color: var(--color-paper-soft);
    font-size: var(--text-lg);
    opacity: 0;
  }
  .hero__status {
    margin-top: 1.3rem;
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    font-size: var(--text-sm);
    opacity: 0;
  }
  .hero__status-key {
    color: var(--color-hazard);
    font-size: var(--text-xs);
    letter-spacing: 0.16em;
    border: 1px solid color-mix(in srgb, var(--color-hazard) 45%, transparent);
    border-radius: 4px;
    padding: 0.2em 0.55em;
  }
  .hero__status-line {
    color: var(--color-paper-soft);
    transition: opacity 0.4s var(--ease-out-expo), transform 0.4s var(--ease-out-expo);
  }
  .hero__status-line.is-swapping { opacity: 0; transform: translateY(-0.4em); }
  .hero__cta {
    margin-top: 2.2rem;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    opacity: 0;
  }
  .hero__avail {
    margin-top: 1.2rem;
    display: flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--color-field-bright);
    font-size: var(--text-sm);
    opacity: 0;
  }
  .hero__avail-dot {
    width: 7px; height: 7px; border-radius: 50%;
    background: currentColor; flex: none;
    box-shadow: 0 0 0 0 color-mix(in srgb, var(--color-field-bright) 60%, transparent);
    animation: avail-pulse 2.4s var(--ease-in-out-quart, ease-in-out) infinite;
  }
  @keyframes avail-pulse {
    0%, 100% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--color-field-bright) 55%, transparent); }
    50% { box-shadow: 0 0 0 5px transparent; }
  }
  @media (prefers-reduced-motion: reduce) { .hero__avail-dot { animation: none; } }

  /* ---- HUD: bottom-right instrument readout ---- */
  .hud {
    position: absolute;
    right: clamp(1.25rem, 4vw, 3rem);
    bottom: clamp(3rem, 9vh, 6.5rem);
    z-index: 2;
    display: grid;
    gap: 0.45rem;
    padding: 0.9rem 1.1rem;
    border-radius: 10px;
    border: 1px solid color-mix(in srgb, var(--color-line) 70%, transparent);
    background: color-mix(in srgb, var(--color-ink) 62%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    color: var(--color-muted);
    opacity: 0;
    text-align: right;
  }
  .hud__row { display: grid; grid-template-columns: 4.5rem auto; gap: 1rem; align-items: center; }
  .hud__k { color: var(--color-field-bright); text-align: left; }
  .hud__v { color: var(--color-paper-soft); font-variant-numeric: tabular-nums; white-space: nowrap; }
  .hud__bar { display: inline-block; width: 6rem; height: 1px; background: var(--color-line); position: relative; vertical-align: middle; }
  .hud__bar::after {
    content: ''; position: absolute; inset: -1px auto -1px 0; width: 100%;
    background: var(--color-field-bright); transform-origin: left; transform: scaleX(0);
    animation: hud-scroll linear both; animation-timeline: scroll(root); animation-range: 0 100vh;
  }
  @keyframes hud-scroll { to { transform: scaleX(1); } }
  @media (max-width: 900px) { .hud { display: none; } }

  /* SplitText mask wrappers */
  .hero__title :global(.split-line-inner) { display: block; }
</style>

<script>
  // Headline reveal + status rotator + HUD readouts.
  import '../lib/hero';
  import '../lib/hud';
</script>
