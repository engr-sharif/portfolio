---
/**
 * The opening: the name set over the ground. On wide screens the text holds
 * the left of the screen and the state rises on the right; on phones the map
 * fills the top of the screen and the text follows on a sheet.
 */
import { withBase } from '../../lib/path';
import { site } from '../../lib/site';
import { profile } from '../../lib/profile';

const pe = profile.credentials.find((c) => /PE|Professional/.test(c.label));
---
<section class="opening" id="top" data-stratum="Opening" data-code="OL" data-pattern="lith-topsoil" aria-labelledby="opening-name"
  data-ground="opening" data-fig="Fig. 0" data-caption="California on real elevation (SRTM)">
  <div class="window window--hero" aria-hidden="true"></div>
  <div class="wrap opening__wrap">
    <div class="opening__text">
      <dl class="opening__tb">
        <div><dt class="label">Discipline</dt><dd>Environmental Engineer, EIT</dd></div>
        <div><dt class="label">Based in</dt><dd>{site.location}</dd></div>
        {pe && <div><dt class="label">Licensure</dt><dd>PE, {pe.date.toLowerCase()}</dd></div>}
      </dl>
      <h1 class="opening__name" id="opening-name"><span>Mohammad</span> <span>Sharif</span></h1>
      <p class="opening__thesis">Environmental engineer on California remediation and landfill projects, currently leading Phase 1 construction on the Sulphur Bank Mercury Mine Superfund cleanup.</p>
      <div class="opening__actions">
        <a class="btn" href="#atlas">See the work <span class="arrow" aria-hidden="true">↓</span></a>
        <a class="btn btn--line" href={withBase('/cv/')}>Read the CV</a>
      </div>
      <p class="opening__hint mono" aria-hidden="true"><span class="opening__hint-fine">Move over the map to read coordinates · drag to turn it</span><span class="opening__hint-scroll">Scroll: the map follows the page</span></p>
    </div>
  </div>
</section>

<style>
  .opening { position: relative; }
  .opening__wrap { position: relative; }
  .opening__text { container-type: inline-size; display: grid; align-content: start; gap: clamp(1.5rem, 1rem + 2vw, 2.75rem); pointer-events: auto; }
  .opening__tb {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid var(--rule-2);
    border-left: 1px solid var(--rule-2);
    max-width: 40rem;
  }
  /* two across on a narrow column (an odd last cell takes the row), all in one row when there's room */
  .opening__tb > div:last-child:nth-child(odd) { grid-column: 1 / -1; }
  @container (min-width: 34rem) {
    .opening__tb { grid-template-columns: none; grid-auto-flow: column; grid-auto-columns: minmax(0, 1fr); }
    .opening__tb > div:last-child:nth-child(odd) { grid-column: auto; }
  }
  .opening__tb > div { padding: 0.6rem 0.8rem 0.7rem; border-right: 1px solid var(--rule-2); border-bottom: 1px solid var(--rule-2); display: grid; gap: 0.25rem; background: var(--ground-2); }
  .opening__tb dd { margin: 0; font-size: 0.9375rem; font-weight: 520; }
  .opening__name {
    font-size: min(var(--t-display), 19.5cqi);
    font-weight: 500;
    line-height: 0.86;
    letter-spacing: -0.045em;
    margin-left: -0.05em;
  }
  .opening__name span { display: block; }
  .opening__thesis { font-family: var(--f-text); font-size: var(--t-lede); line-height: 1.4; max-width: 36ch; text-wrap: pretty; }
  .opening__actions { display: flex; flex-wrap: wrap; gap: var(--s-3); }
  .opening__hint { font-size: 0.6875rem; color: var(--ink-3); letter-spacing: 0.02em; }
  .opening__hint-fine { display: none; }
  @media (pointer: fine) { .opening__hint-fine { display: inline; } .opening__hint-scroll { display: none; } }

  @media (prefers-reduced-motion: no-preference) {
    .opening__name span { animation: survey-in 1.7s var(--ease-out) both; }
    .opening__name span + span { animation-delay: 90ms; }
    .opening__thesis, .opening__actions, .opening__hint { animation: settle 1.1s var(--ease-out) 0.45s both; }
  }
  @keyframes survey-in {
    from { font-stretch: 62%; letter-spacing: 0.02em; opacity: 0.15; }
    to { font-stretch: 100%; letter-spacing: -0.045em; opacity: 1; }
  }
  @keyframes settle { from { opacity: 0; transform: translateY(0.75rem); } to { opacity: 1; transform: none; } }

  /* phones: map on top, text on a sheet below */
  @media (max-width: 63.99rem) {
    .opening__wrap { background: var(--ground); padding-block: var(--s-7) var(--s-8); }
    .opening__wrap::before { content: ''; position: absolute; left: 0; right: 0; bottom: 100%; height: 5rem; background: linear-gradient(to top, var(--ground), transparent); pointer-events: none; }
    .opening__name { font-size: min(var(--t-display), 22cqi); }
  }
  /* wide: the name over the land, a veil keeping the text legible */
  @media (min-width: 64rem) {
    .opening { min-height: calc(100svh - var(--nav-h)); display: grid; align-items: center; }
    .opening::before {
      content: '';
      position: absolute; inset: 0 auto 0 calc(-1 * var(--rail-w, 0px));
      width: calc(56% + var(--rail-w, 0px));
      background: linear-gradient(to right, var(--ground) 0%, var(--ground) 62%, color-mix(in srgb, var(--ground) 0%, transparent) 100%);
      pointer-events: none;
    }
    .opening__text { width: 50%; padding-block: var(--s-7) var(--s-9); }
  }
</style>
