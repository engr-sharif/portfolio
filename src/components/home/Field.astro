---
/**
 * 5.0 From the field — the photographs, on a sheet, while the map stands
 * them as a hand of cards at the site where they were taken (their project's
 * public position when they carry no GPS of their own). Scrolling through
 * the sheet turns the camera around the site, card by card. Every photo
 * opens in the viewer with its caption.
 */
import { getImage } from '../../lib/images';
import { getCaption } from '../../lib/captions';
import { groundPhotos } from '../../lib/ground';
import { getProjects } from '../../lib/projects';
import SectionHead from '../ui/SectionHead.astro';
import Figure from '../ui/Figure.astro';

const titles = new Map((await getProjects()).map((p) => [p.id, p.data.title.replace(/ — .*$/, '')]));
const photos = (await groundPhotos())
  .map((p) => ({ ...p, img: getImage(p.image)! }))
  .map((p) => ({ ...p, caption: p.caption || getCaption(p.image), alt: p.alt || p.caption || getCaption(p.image) || 'Field photograph' }));
// one camera stop per row of two: the mean of the row's places in the stack
const rowIndex = (i: number) => {
  const row = photos.slice(i - (i % 2), i - (i % 2) + 2).map((p) => p.stack).filter((x): x is number => x != null);
  return row.length ? row.reduce((a, b) => a + b, 0) / row.length : null;
};
const firstPlaced = photos.find((p) => p.place);
const where = firstPlaced?.place && 'slug' in firstPlaced.place && firstPlaced.place.slug ? titles.get(firstPlaced.place.slug) : null;
const caption = where ? `Photographs at ${where}, placed at the project’s position` : 'Where the photographs were taken';
---
{photos.length > 0 && (
  <section class="sec field" id="field" data-stratum="From the field" data-code="GP" data-pattern="lith-gravel" aria-labelledby="field-title">
    <div class="wrap">
      <div class="panel">
        <div data-ground={firstPlaced ? 'photo' : 'plan'} data-index="0" data-fig="Fig. 5.0" data-caption={caption}>
          <SectionHead no="5.0" id="field-title" title="From the field" intro="Photographs from site: the ground itself, the instruments, and the work of sampling it." />
        </div>
        {firstPlaced && <div class="window" aria-hidden="true" data-ground="photo" data-index="0" data-fig="Fig. 5.0" data-caption={caption}></div>}
        <div class="field__sheet">
          {photos.map((p, i) => {
            const stop = i % 2 === 0 ? rowIndex(i) : null;
            return (
              <div class="field__cell" {...(stop != null ? { 'data-ground': 'photo', 'data-index': String(stop), 'data-fig': `Fig. 5.${i + 1}`, 'data-caption': caption } : {})}>
                <Figure image={p.img} alt={p.alt} caption={p.caption} no={`5.${i + 1}`} group="field" aspect="4 / 3" sizes="(min-width: 64rem) 22vw, 46vw" widths={[360, 540, 720]} />
              </div>
            );
          })}
        </div>
      </div>
    </div>
  </section>
)}

<style>
  .field__sheet { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s-6) var(--gap); margin-top: var(--s-7); }
  .field__sheet :global(.fig__cap) { font-size: 0.875rem; }
</style>
