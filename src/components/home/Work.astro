---
/**
 * 2.0 Selected work — each project on a sheet of its own, standing over its
 * site: while a sheet is on screen the map is that site's real ground up
 * close (40 km across, centred on the rounded position, with the precision
 * ring drawn). Between sheets the camera lifts off and flies to the next.
 * Without WebGL the sheet carries its own figure instead.
 */
import { getFeatured, getProjects, dateRange } from '../../lib/projects';
import { getImage } from '../../lib/images';
import { withBase } from '../../lib/path';
import { publicPosition } from '../../lib/atlas';
import { patchFor } from '../../lib/sites';
import SectionHead from '../ui/SectionHead.astro';
import Figure from '../ui/Figure.astro';
import Locator from '../ui/Locator.astro';
import Status from '../ui/Status.astro';

const featured = (await getFeatured()).slice(0, 3);
const total = (await getProjects()).length;
---
<section class="sec work" id="work" data-stratum="Selected work" data-code="CL" data-pattern="lith-clay" aria-labelledby="work-title">
  <div class="wrap">
    <div class="panel work__head">
      <SectionHead no="2.0" id="work-title" title="Selected work" intro="Each project is written up like a report: the setting, my role, what I did and what came of it." />
    </div>
    <ol class="work__list">
      {featured.map((p, i) => {
        const d = p.data;
        const cover = getImage(d.coverImage);
        const href = withBase(`/projects/${p.id}/`);
        const pos = publicPosition(d);
        const patch = patchFor(d);
        const name = d.title.replace(/ — .*$/, '');
        const stage = pos
          ? { 'data-ground': 'close', 'data-slug': p.id, 'data-index': String(i), 'data-fig': `Fig. 2.${i + 1}`, 'data-caption': `${name} · ${patch ? Math.round((patch.north - patch.south) * 111.32) : 40} km around the site, position to ~${patch?.radiusKm ?? 1} km` }
          : { 'data-ground': 'plan', 'data-fig': `Fig. 2.${i + 1}`, 'data-caption': `${name} · several sites` };
        return (
          <li class="work__item">
            <div class="window" aria-hidden="true" {...stage}></div>
            <article class="panel work__panel" {...stage}>
              <p class="work__no mono">2.{i + 1}</p>
              <p class="label">{d.siteType}</p>
              <h3 class="work__title" style={`view-transition-name: title-${p.id}`}><a href={href}>{d.title}</a></h3>
              <p class="work__summary">{d.summary}</p>
              {cover ? (
                <a class="work__fig" href={href} tabindex="-1" aria-hidden="true">
                  <Figure image={cover} alt={d.coverAlt || `${d.title}, ${d.siteType}`} aspect="16 / 10" sizes="(min-width: 64rem) 40vw, 92vw" widths={[480, 720, 960, 1280]} vt={`fig-${p.id}`} marked>
                    {d.film && (
                      <>
                        {/* the film's loop plays in the cover's place and carries on, from the same moment, on the project page */}
                        <video class="work__loop" data-loop muted loop playsinline preload="none" aria-hidden="true" poster={withBase(d.film.loopPoster ?? d.film.poster)}>
                          <source src={withBase(d.film.loop)} type="video/mp4" />
                          {d.film.loopWebm && <source src={withBase(d.film.loopWebm)} type="video/webm" />}
                        </video>
                        <span class="work__film mono"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M5.5 3.5v9l7-4.5z" fill="currentColor" /></svg>Film{d.film.duration ? ` · ${Math.floor(d.film.duration / 60)}:${String(Math.round(d.film.duration % 60)).padStart(2, '0')}` : ''}</span>
                      </>
                    )}
                  </Figure>
                </a>
              ) : pos ? (
                <a class="work__fig work__still" href={href} tabindex="-1" aria-hidden="true">
                  <Locator lat={pos.lat} lng={pos.lng} name={name} place={d.location} caption={`${d.location ?? 'California'}. Position rounded to about ${patch?.radiusKm ?? 1} km.`} />
                </a>
              ) : null}
              <dl class="work__facts">
                <div><dt class="label">Role</dt><dd>{d.role}</dd></div>
                <div><dt class="label">Dates</dt><dd class="mono">{dateRange(d.startDate, d.endDate, d.status)}</dd></div>
                {d.location && <div><dt class="label">Where</dt><dd>{d.location}</dd></div>}
                <div><dt class="label">Status</dt><dd><Status status={d.status} /></dd></div>
              </dl>
              <a class="go" href={href}>Read the report <span class="arrow" aria-hidden="true">→</span></a>
            </article>
          </li>
        );
      })}
    </ol>
    <div class="panel work__foot">
      <p><a class="btn btn--line" href={withBase('/projects/')}>All {total} projects <span class="arrow" aria-hidden="true">→</span></a></p>
    </div>
  </div>
</section>

<style>
  .work__list { list-style: none; padding: 0; display: grid; }
  .work__item { display: grid; }
  .work__panel { display: grid; align-content: start; gap: var(--s-3); }
  .work__no { color: var(--cinnabar-ink); }
  .work__title { font-size: clamp(1.875rem, 1.4rem + 1.5vw, 2.75rem); font-weight: 530; letter-spacing: -0.028em; line-height: 1.02; margin-block: var(--s-1) var(--s-2); }
  .work__title a { text-decoration: none; }
  .work__title a:hover { color: var(--cinnabar-ink); }
  .work__summary { font-family: var(--f-text); font-size: var(--t-body); line-height: var(--lh-text); color: var(--ink-2); max-width: 46ch; }
  .work__fig { display: block; text-decoration: none; color: inherit; margin-top: var(--s-4); }
  .work__loop { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .work__film {
    position: absolute; left: 0.75rem; top: 0.75rem;
    display: inline-flex; align-items: center; gap: 0.4rem;
    padding: 0.3rem 0.6rem 0.3rem 0.45rem;
    border-radius: 999px;
    background: rgb(10 12 10 / 0.5);
    -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px);
    color: #f2f3ee;
    font-size: 0.6875rem; letter-spacing: 0.08em; text-transform: uppercase;
  }
  .work__film svg { width: 0.7rem; height: 0.7rem; color: #ff6a45; }
  .work__facts { display: grid; grid-template-columns: 1fr 1fr; gap: var(--s-4) var(--s-5); margin: var(--s-4) 0 var(--s-5); padding-top: var(--s-4); border-top: 1px solid var(--rule); }
  .work__facts > div { display: grid; gap: 0.3rem; align-content: start; }
  .work__facts dd { margin: 0; font-size: 0.9375rem; line-height: 1.35; }
  .work__panel > .go { justify-self: start; }
  /* the live close-up replaces the drawn locator */
  :global(.ground-live) .work__still { display: none; }
  @media (min-width: 64rem) {
    .work__item { padding-block: 22vh; }
    .work__item:first-child { padding-top: 12vh; }
  }
</style>
