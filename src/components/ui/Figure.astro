---
/**
 * A numbered figure: a photo in a thin frame, "Fig. 3" in mono and the caption
 * in the reading face. With `group`, the frame is a button that opens the
 * figure viewer (and steps through every figure in the same group).
 */
import type { ImageMetadata } from 'astro';
import { Image, getImage } from 'astro:assets';

export interface Props {
  image: ImageMetadata;
  alt: string;
  no?: string;
  caption?: string;
  /** Viewer group; omit for a figure that doesn't open. */
  group?: string;
  aspect?: string;
  sizes?: string;
  widths?: number[];
  eager?: boolean;
  /** view-transition-name, so the figure can morph between pages. */
  vt?: string;
  marked?: boolean;
  position?: string;
  class?: string;
}
const {
  image, alt, no, caption, group, aspect, eager = false, vt, marked = false, position,
  sizes = '(min-width: 90rem) 1200px, 92vw',
  widths = [480, 800, 1200, 1600],
  class: cls,
} = Astro.props;

const full = group ? await getImage({ src: image, width: Math.min(2400, image.width), format: 'webp', quality: 82 }) : null;
const style = [aspect && `aspect-ratio: ${aspect}`, vt && `view-transition-name: ${vt}`].filter(Boolean).join('; ');
const imgStyle = position ? `object-position: ${position}` : undefined;
const Tag = group ? 'button' : 'div';
---
<figure class:list={['fig', marked && 'fig--marked', cls]}>
  <Tag
    class="fig__frame"
    style={style || undefined}
    type={group ? 'button' : undefined}
    data-lightbox={group}
    data-src={full?.src}
    data-caption={group ? caption : undefined}
    data-no={group && no ? `Fig. ${no}` : undefined}
    aria-label={group ? `Open figure${no ? ` ${no}` : ''}: ${alt}` : undefined}
  >
    <Image src={image} alt={alt} widths={widths.filter((w) => w <= image.width)} sizes={sizes} loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : undefined} decoding="async" format="webp" quality={78} style={imgStyle} />
  </Tag>
  {(no || caption) && (
    <figcaption class="fig__cap">
      {no && <span class="fig__no">Fig. {no}</span>}
      {caption && <span>{caption}</span>}
    </figcaption>
  )}
</figure>
