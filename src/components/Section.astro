---
export interface Props {
  id?: string;
  eyebrow?: string;
  title?: string;
  class?: string;
}
const { id, eyebrow, title, class: className = '' } = Astro.props;
---
<section id={id} class={`section ${className}`}>
  <div class="u-container">
    {(eyebrow || title) && (
      <header class="section__head">
        {eyebrow && <p class="section__eyebrow" data-reveal>{eyebrow}</p>}
        {title && (
          <h2 class="section__title" data-reveal data-reveal-delay="0.05">
            {title}
          </h2>
        )}
      </header>
    )}
    <slot />
  </div>
</section>

<style>
  .section__head { margin-bottom: clamp(2rem, 5vw, 4rem); max-width: 48ch; }
  .section__title { font-size: var(--text-2xl); margin-top: 1rem; }
</style>
