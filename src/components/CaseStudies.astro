---
/**
 * Selected work, case-study first. Each featured project is a full-width row:
 * the cover framed as a report figure, and a brief — Problem / Approach /
 * Outcome when the author has written them, the summary otherwise — with the
 * dates, role and techniques in the mono data voice.
 */
import { Image } from 'astro:assets';
import Section from './Section.astro';
import StatusBadge from './atlas/StatusBadge.astro';
import { getCover } from '../lib/images';
import { withBase } from '../lib/path';
import { getProjects, getFeatured, dateRange } from '../lib/projects';

const all = await getProjects();
const featured = await getFeatured();
const rows = (featured.length >= 2 ? featured : all).slice(0, 3);
---
{rows.length > 0 && (
  <Section id="work" eyebrow="Case studies" title="Selected work, read like a report">
    <div class="cases">
      {rows.map((project, i) => {
        const { data } = project;
        const cover = getCover(data.coverImage);
        const href = withBase(`projects/${project.id}/`);
        const brief = [
          data.problem && { k: 'Problem', v: data.problem },
          data.approach && { k: 'Approach', v: data.approach },
          data.outcome && { k: 'Outcome', v: data.outcome },
        ].filter(Boolean) as { k: string; v: string }[];
        return (
          <article class={`case${i % 2 ? ' case--flip' : ''}`} data-reveal>
            <a class="case__media" href={href} aria-label={`Open case study: ${data.title}`} tabindex="-1">
              {cover ? (
                <Image
                  src={cover}
                  alt={data.coverAlt || `${data.title} — ${data.siteType}`}
                  widths={[600, 1000, 1400]}
                  sizes="(max-width: 900px) 92vw, 48vw"
                  loading="lazy"
                  class="case__img"
                  style={`view-transition-name: cover-${project.id}`}
                />
              ) : (
                <div class="case__img case__img--placeholder" aria-hidden="true"></div>
              )}
              <span class="figure__corner figure__corner--bl" aria-hidden="true"></span>
              <span class="figure__corner figure__corner--br" aria-hidden="true"></span>
              <span class="case__fig u-mono" aria-hidden="true">FIG. {String(i + 1).padStart(2, '0')}</span>
            </a>

            <div class="case__body">
              <p class="case__eyebrow u-mono">
                <span>{data.siteType}</span>
                <StatusBadge status={data.status} />
              </p>
              <h3 class="case__title"><a href={href}>{data.title}</a></h3>

              {brief.length > 0 ? (
                <dl class="case__brief">
                  {brief.map((b) => (
                    <div>
                      <dt>{b.k}</dt>
                      <dd>{b.v}</dd>
                    </div>
                  ))}
                </dl>
              ) : (
                <p class="case__summary">{data.summary}</p>
              )}

              <dl class="case__facts u-mono">
                <div><dt>Dates</dt><dd>{dateRange(data.startDate, data.endDate, data.status)}</dd></div>
                <div><dt>Role</dt><dd>{data.role}</dd></div>
                {data.location && <div><dt>Where</dt><dd>{data.location}</dd></div>}
              </dl>

              <ul class="case__tags">
                {data.techniques.slice(0, 5).map((t) => <li class="chip">{t}</li>)}
              </ul>

              <a href={href} class="case__link link-underline">Read the case study <span aria-hidden="true">→</span></a>
            </div>
          </article>
        );
      })}
    </div>

    {all.length > rows.length && (
      <p style="margin-top:3rem;">
        <a href={withBase('projects/')} class="btn btn--ghost" data-magnetic="0.3">All {all.length} projects →</a>
      </p>
    )}
  </Section>
)}

<style>
  .cases { display: flex; flex-direction: column; gap: clamp(3rem, 7vw, 5.5rem); }
  .case {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(1.5rem, 3vw, 3rem);
    align-items: center;
  }
  @media (min-width: 900px) {
    .case { grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); }
    .case--flip .case__media { order: 2; }
  }
  .case__media {
    position: relative;
    display: block;
    border-radius: 6px;
    overflow: hidden;
    border: 1px solid var(--color-line);
    background: var(--color-ink-1);
    aspect-ratio: 4 / 3;
  }
  .case__img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.8s var(--ease-out-expo); }
  .case__media:hover .case__img { transform: scale(1.03); }
  .case__img--placeholder { background: linear-gradient(135deg, var(--color-field-dim), var(--color-ink-1)); }
  .case__media .figure__corner { opacity: 0.8; }
  .case__fig {
    position: absolute; left: 0.9rem; top: 0.9rem;
    font-size: var(--text-xs); letter-spacing: 0.12em; color: var(--color-field-bright);
    background: color-mix(in srgb, var(--color-ink) 70%, transparent); backdrop-filter: blur(6px);
    padding: 0.25em 0.6em; border-radius: 4px;
  }
  .case__body { display: flex; flex-direction: column; gap: 1.1rem; }
  .case__eyebrow { display: flex; align-items: center; gap: 0.9rem; color: var(--color-muted); font-size: var(--text-xs); letter-spacing: 0.1em; text-transform: uppercase; }
  .case__title { font-size: var(--text-2xl); line-height: 1.05; max-width: 18ch; }
  .case__title a:hover { color: var(--color-field-bright); }
  .case__summary { color: var(--color-paper-soft); max-width: 52ch; }
  .case__brief { display: grid; grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr)); gap: 1.2rem; border-top: 1px solid var(--color-line); padding-top: 1.1rem; }
  .case__brief dt { font-family: var(--font-mono); font-size: var(--text-xs); letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-field-bright); }
  .case__brief dd { margin-top: 0.4rem; color: var(--color-paper-soft); font-size: var(--text-sm); line-height: 1.55; }
  .case__facts { display: flex; flex-wrap: wrap; gap: 1.5rem; font-size: var(--text-xs); }
  .case__facts dt { color: var(--color-muted); letter-spacing: 0.12em; text-transform: uppercase; }
  .case__facts dd { margin-top: 0.25rem; color: var(--color-paper); }
  .case__tags { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .case__link { align-self: flex-start; color: var(--color-field-bright); font-size: var(--text-sm); }
</style>
