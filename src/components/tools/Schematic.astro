---
/**
 * Line drawings, one per tool — what the tool does, drawn like a figure in a
 * methods section. No screenshots of project data (confidential), no stock
 * art. Keyed by tool slug; anything unknown gets the survey grid.
 */
export interface Props { slug: string; label?: string }
const { slug, label } = Astro.props;
const known = ['soil-sampling-planning-tool', 'xrf-data-app', 'soil-contamination-visualizer', 'boring-data-explorer', 'cyclic-report-qc-tool', 'portfolio-site'];
const kind = known.includes(slug) ? slug : 'generic';
const uid = `sch-${slug.replace(/[^a-z0-9]/g, '')}`;

// Sampling grid (planning tool): 11 × 6 nodes; the gap is a region with no data.
const nodes: { x: number; y: number; state: 'have' | 'gap' | 'new' }[] = [];
for (let r = 0; r < 6; r++) for (let c = 0; c < 11; c++) {
  const x = 38 + c * 24, y = 40 + r * 24;
  const inGap = (x - 196) ** 2 / 4200 + (y - 110) ** 2 / 1500 < 1;
  const proposed = inGap && (c + r) % 2 === 0;
  nodes.push({ x, y, state: proposed ? 'new' : inGap ? 'gap' : 'have' });
}

// Contours for the visualizer: nested closed curves around a source.
const contour = (k: number) => {
  const pts: string[] = [];
  for (let i = 0; i <= 48; i++) {
    const t = (i / 48) * Math.PI * 2;
    const r = k * (1 + 0.16 * Math.sin(3 * t + k * 0.03) + 0.08 * Math.cos(5 * t));
    pts.push(`${(170 + r * 1.55 * Math.cos(t)).toFixed(1)},${(104 + r * Math.sin(t)).toFixed(1)}`);
  }
  return `M${pts.join('L')}Z`;
};

// Terrain contours for this site: stacked wavy lines.
const topo = (i: number) => {
  const pts: string[] = [];
  for (let x = 0; x <= 320; x += 10) {
    const y = 34 + i * 13 + Math.sin(x / 38 + i * 0.6) * (10 - i * 0.6) + Math.cos(x / 17 + i) * 2.5;
    pts.push(`${x},${y.toFixed(1)}`);
  }
  return `M${pts.join('L')}`;
};
---
<svg class={`schematic schematic--${kind}`} viewBox="0 0 320 200" role="img" aria-label={label ?? 'Schematic drawing'}>
  <defs>
    <pattern id={`${uid}-hatch`} width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(45)"><path d="M0 0v6" class="s-faint" /></pattern>
    <pattern id={`${uid}-sand`} width="5" height="5" patternUnits="userSpaceOnUse"><circle cx="1.2" cy="1.2" r=".6" class="s-dot" /><circle cx="3.7" cy="3.7" r=".6" class="s-dot" /></pattern>
    <pattern id={`${uid}-clay`} width="8" height="4" patternUnits="userSpaceOnUse"><path d="M0 2h8" class="s-line" /></pattern>
    <pattern id={`${uid}-gravel`} width="10" height="9" patternUnits="userSpaceOnUse"><circle cx="3" cy="3" r="1.8" class="s-line" fill="none" /><circle cx="8" cy="7" r="1.3" class="s-line" fill="none" /></pattern>
  </defs>

  {kind === 'soil-sampling-planning-tool' && (
    <g>
      <path d="M22 30 L250 24 L300 66 L292 176 L60 184 L20 120 Z" class="s-bound" fill="none" />
      <ellipse cx="196" cy="110" rx="65" ry="39" fill={`url(#${uid}-hatch)`} class="s-gapline" />
      {nodes.map((n) => n.state === 'have'
        ? <circle cx={n.x} cy={n.y} r="2.6" class="s-fill" />
        : n.state === 'new'
          ? <path d={`M${n.x - 4} ${n.y}h8M${n.x} ${n.y - 4}v8`} class="s-hot" />
          : null)}
      <g class="s-text"><circle cx="30" cy="196" r="2.4" class="s-fill" /><text x="36" y="199">sampled</text><path d="M86 196h8M90 192v8" class="s-hot" /><text x="99" y="199">proposed</text><rect x="152" y="192" width="9" height="7" fill={`url(#${uid}-hatch)`} class="s-gapline" /><text x="166" y="199">data gap</text></g>
    </g>
  )}

  {kind === 'xrf-data-app' && (
    <g>
      <g class="s-text"><text x="20" y="22">gun A · csv</text><text x="20" y="112">gun B · csv</text><text x="206" y="22">master tracker</text></g>
      {[0, 1, 2, 3, 4].map((i) => <rect x="20" y={30 + i * 12} width={72 - (i % 3) * 10} height="5" class="s-bar" />)}
      {[0, 1, 2, 3].map((i) => <rect x="20" y={120 + i * 12} width={64 - (i % 2) * 12} height="5" class="s-bar" />)}
      <rect x="206" y="30" width="96" height="140" fill="none" class="s-line" />
      {[1, 2, 3, 4, 5, 6, 7, 8, 9].map((i) => <path d={`M206 ${30 + i * 14}h96`} class="s-faint" />)}
      <path d="M244 30v140M272 30v140" class="s-faint" />
      {[[32, 51], [44, 65], [56, 93], [68, 107], [122, 121], [134, 135], [146, 149]].map(([a, b]) => <path d={`M96 ${a + 2} C150 ${a + 2}, 150 ${b}, 204 ${b}`} fill="none" class="s-line" />)}
      <path d="M96 82 C150 82, 150 163, 204 163" fill="none" class="s-hot" stroke-dasharray="3 3" />
      <circle cx="226" cy="163" r="4.5" class="s-hot" fill="none" /><text x="224" y="165.5" class="s-text s-hottext" text-anchor="middle" font-size="7">?</text>
    </g>
  )}

  {kind === 'soil-contamination-visualizer' && (
    <g>
      {[28, 48, 70, 94].map((k) => <path d={contour(k)} fill="none" class={k === 48 ? 's-hot' : 's-line'} />)}
      {[[140, 96, 2], [182, 108, 2], [164, 124, 2], [120, 70, 1], [226, 86, 1], [210, 140, 1], [96, 128, 0], [260, 60, 0], [70, 60, 0], [262, 160, 0], [150, 170, 1], [196, 46, 0]].map(([x, y, s]) =>
        s === 2 ? <circle cx={x} cy={y} r="3.4" class="s-hotfill" /> : s === 1 ? <circle cx={x} cy={y} r="3" class="s-fill" /> : <circle cx={x} cy={y} r="3" fill="none" class="s-line" />)}
      <g class="s-text"><rect x="20" y="186" width="120" height="5" class="s-bar" /><rect x="84" y="186" width="56" height="5" class="s-hotfill" /><path d="M84 180v14" class="s-line" /><text x="20" y="180">concentration →</text><text x="88" y="179">limit</text></g>
    </g>
  )}

  {kind === 'boring-data-explorer' && (
    <g>
      <rect x="20" y="20" width="176" height="160" fill="none" class="s-line" />
      <path d="M20 90 C70 70, 120 118, 196 96" fill="none" class="s-faint" />
      <path d="M92 20 C100 80, 84 130, 110 180" fill="none" class="s-faint" />
      {[[58, 54, 12], [140, 62, 5], [70, 134, 8], [150, 142, 3]].map(([x, y, n]) => (
        <g><circle cx={x} cy={y} r={9 + n * 0.6} class="s-cluster" /><text x={x} y={y + 3.2} text-anchor="middle" class="s-text s-num">{n}</text></g>
      ))}
      <circle cx="116" cy="104" r="4" class="s-hotfill" />
      <path d="M120 104 H222" class="s-hot" stroke-dasharray="2 3" />
      <rect x="224" y="20" width="38" height="160" fill="none" class="s-line" />
      <rect x="224" y="20" width="38" height="22" fill={`url(#${uid}-sand)`} class="s-line" />
      <rect x="224" y="42" width="38" height="46" fill={`url(#${uid}-clay)`} class="s-line" />
      <rect x="224" y="88" width="38" height="34" fill={`url(#${uid}-gravel)`} class="s-line" />
      <rect x="224" y="122" width="38" height="58" fill={`url(#${uid}-sand)`} class="s-line" />
      <g class="s-text">{[0, 10, 20, 30].map((d, i) => <text x="270" y={24 + i * 50}>{d} ft</text>)}</g>
    </g>
  )}

  {kind === 'cyclic-report-qc-tool' && (
    <g>
      <g class="s-text"><text x="24" y="22">prior cycle</text><text x="176" y="22">this cycle</text></g>
      <rect x="24" y="30" width="120" height="152" fill="none" class="s-line" />
      <rect x="176" y="30" width="120" height="152" fill="none" class="s-line" />
      {[0, 1, 2, 3, 4, 5, 6, 7, 8].map((i) => <rect x="34" y={42 + i * 15} width={i % 3 === 2 ? 70 : 100} height="4" class="s-bar" />)}
      {[0, 1, 2, 3, 4, 5, 6, 7, 8].map((i) => (
        i === 2 ? <g><rect x="186" y={42 + i * 15} width="70" height="4" class="s-bar" /><rect x="224" y={40 + i * 15} width="24" height="8" class="s-hotwash" /><path d={`M224 ${49 + i * 15}h24`} class="s-hot" /></g>
        : i === 5 ? <g><rect x="186" y={42 + i * 15} width="100" height="4" class="s-bar" /><rect x="202" y={40 + i * 15} width="30" height="8" class="s-hotwash" /><path d={`M202 ${49 + i * 15}h30`} class="s-hot" /></g>
        : i === 7 ? <rect x="186" y={42 + i * 15} width="84" height="4" class="s-fill" />
        : <rect x="186" y={42 + i * 15} width={i % 3 === 2 ? 70 : 100} height="4" class="s-bar" />
      ))}
      <g class="s-text"><text x="160" y="77" text-anchor="middle" class="s-hottext">Δ</text><text x="160" y="122" text-anchor="middle" class="s-hottext">Δ</text><text x="160" y="152" text-anchor="middle">+</text><text x="160" y="47" text-anchor="middle">=</text></g>
    </g>
  )}

  {kind === 'portfolio-site' && (
    <g>
      {[0, 1, 2, 3, 4, 5, 6, 7, 8].map((i) => <path d={topo(i)} fill="none" class={i === 4 ? 's-line' : 's-faint'} />)}
      <path d="M40 22 L280 172" class="s-hot" stroke-dasharray="5 4" />
      <g class="s-text"><text x="30" y="18">A</text><text x="284" y="186">A′</text></g>
      <circle cx="40" cy="22" r="3" class="s-hotfill" /><circle cx="280" cy="172" r="3" class="s-hotfill" />
    </g>
  )}

  {kind === 'generic' && (
    <g>
      {[0, 1, 2, 3, 4, 5, 6].map((i) => <path d={`M${40 + i * 40} 20v160`} class="s-faint" />)}
      {[0, 1, 2, 3, 4].map((i) => <path d={`M20 ${40 + i * 30}h280`} class="s-faint" />)}
      <circle cx="160" cy="100" r="10" fill="none" class="s-hot" />
      <path d="M160 82v36M142 100h36" class="s-hot" />
    </g>
  )}
</svg>

<style>
  .schematic { width: 100%; height: auto; display: block; overflow: visible; }
  .schematic :global(.s-line) { stroke: var(--ink-2); stroke-width: 1; vector-effect: non-scaling-stroke; }
  .schematic :global(.s-faint) { stroke: var(--rule-2); stroke-width: 1; vector-effect: non-scaling-stroke; fill: none; }
  .schematic :global(.s-bound) { stroke: var(--ink-3); stroke-width: 1; stroke-dasharray: 5 4; vector-effect: non-scaling-stroke; }
  .schematic :global(.s-gapline) { stroke: var(--ink-3); stroke-width: 1; stroke-dasharray: 2 3; vector-effect: non-scaling-stroke; }
  .schematic :global(.s-hot) { stroke: var(--cinnabar); stroke-width: 1.5; vector-effect: non-scaling-stroke; fill: none; }
  .schematic :global(.s-fill) { fill: var(--ink-2); }
  .schematic :global(.s-dot) { fill: var(--ink-3); }
  .schematic :global(.s-bar) { fill: var(--rule-2); }
  .schematic :global(.s-hotfill) { fill: var(--cinnabar); }
  .schematic :global(.s-hotwash) { fill: var(--cinnabar-wash); }
  .schematic :global(.s-cluster) { fill: var(--ground); stroke: var(--ink-2); stroke-width: 1; vector-effect: non-scaling-stroke; }
  .schematic :global(.s-text), .schematic :global(.s-text text) { font-family: var(--f-mono); font-size: 8px; fill: var(--ink-3); }
  .schematic :global(.s-num) { font-size: 8.5px; fill: var(--ink); }
  .schematic :global(.s-hottext) { fill: var(--cinnabar-ink); font-size: 11px; }
</style>
