---
/**
 * "Where I've worked" (About page) — the compact Field Atlas map: project
 * sites + geotagged field photos, no list. Data prep lives in lib/atlas.ts and
 * is shared with the homepage FieldAtlas. Coordinates are snapped to ~1 km.
 */
import Section from './Section.astro';
import WorkMapIsland from './WorkMapIsland.tsx';
import { getAtlasPoints } from '../lib/atlas';

const { projects: projectPoints, photos: photoPoints } = await getAtlasPoints();
const hasPoints = projectPoints.length > 0 || photoPoints.length > 0;
const base = import.meta.env.BASE_URL;
---
{hasPoints && (
  <Section id="map" eyebrow="Geographic reach" title="Where I've worked">
    <p class="wm__intro">
      Environmental work across California — site characterization, remediation, and
      compliance monitoring. Pins are approximate; toggle the layers below.
    </p>
    <WorkMapIsland client:visible variant="compact" projects={projectPoints} photos={photoPoints} base={base} />
  </Section>
)}

<style is:global>
  .wm { margin-top: 1.5rem; }
  .wm__intro { color: var(--color-muted); max-width: 52ch; margin: 0 0 1.4rem; }
  .wm__legend { display: flex; flex-wrap: wrap; align-items: center; gap: 0.6rem; margin-bottom: 0.9rem; }
  .wm__toggle {
    display: inline-flex; align-items: center; gap: 0.5rem;
    padding: 0.4rem 0.9rem; border-radius: 999px; font-size: var(--text-sm);
    border: 1px solid var(--color-line); background: var(--color-ink-1); color: var(--color-muted);
    transition: color .2s, border-color .2s, opacity .2s;
  }
  .wm__toggle.is-on { color: var(--color-paper); border-color: color-mix(in srgb, var(--color-field-bright) 50%, transparent); }
  .wm__toggle:not(.is-on) { opacity: 0.55; }
  .wm__swatch { width: 12px; height: 12px; border-radius: 50%; }
  .wm__swatch--project { background: var(--color-field-bright); }
  .wm__swatch--photo { background: var(--color-paper-soft); width: 8px; height: 8px; }
  .wm__note { color: var(--color-muted); font-size: var(--text-xs); font-family: var(--font-mono); margin-left: auto; }

  .wm__stage { position: relative; }
  .wm__canvas {
    height: clamp(360px, 56vw, 560px); width: 100%;
    border-radius: 14px; overflow: hidden;
    border: 1px solid var(--color-line); background: var(--color-ink-1);
  }
  /* graceful degradation: basemap blocked / WebGL missing */
  .wm__fallback {
    position: absolute; inset: 0; display: grid; place-content: center; gap: 0.4rem;
    padding: 2rem; text-align: center; border-radius: 14px;
    background: color-mix(in srgb, var(--color-ink-1) 92%, transparent);
    border: 1px dashed var(--color-line);
  }
  .wm__fallback-title { font-family: var(--font-display); font-size: var(--text-lg); color: var(--color-paper); margin: 0; }
  .wm__fallback-msg { color: var(--color-muted); font-size: var(--text-sm); margin: 0; max-width: 40ch; }
  .wm__fallback-list { list-style: none; padding: 0; margin: 1rem 0 0; display: grid; gap: 0.3rem; font-size: var(--text-sm); }
  .wm__fallback-list a { color: var(--color-field-bright); }
  .wm__fallback-list span { color: var(--color-muted); }
  /* soft shimmer while the style + first tiles load */
  .wm__loading {
    position: absolute; inset: 0; border-radius: 14px; pointer-events: none;
    background: linear-gradient(100deg, transparent 30%, color-mix(in srgb, var(--color-paper) 4%, transparent) 50%, transparent 70%);
    background-size: 220% 100%; animation: wm-shimmer 1.6s ease-in-out infinite;
  }
  @keyframes wm-shimmer { from { background-position: 120% 0; } to { background-position: -120% 0; } }
  @media (prefers-reduced-motion: reduce) { .wm__loading { animation: none; } }

  /* markers (colour tokens follow the theme) */
  .wm-pin { cursor: pointer; }
  .wm-pin--project {
    width: 16px; height: 16px; border-radius: 50%;
    background: var(--pin, var(--color-field-bright)); border: 2px solid var(--color-ink-0);
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--pin, var(--color-field-bright)) 45%, transparent), 0 2px 6px rgba(0,0,0,.35);
  }
  .wm-pin--photo {
    width: 9px; height: 9px; border-radius: 50%;
    background: var(--color-paper-soft); border: 1.5px solid var(--color-ink-0);
    box-shadow: 0 1px 4px rgba(0,0,0,.35);
  }

  /* popups — themed */
  .wm-popup .maplibregl-popup-content {
    background: var(--color-ink-2); color: var(--color-paper);
    border: 1px solid var(--color-line); border-radius: 10px;
    padding: 0.8rem 0.9rem; font-family: var(--font-sans); box-shadow: 0 16px 40px rgba(0,0,0,.35);
  }
  .wm-popup .maplibregl-popup-tip { border-top-color: var(--color-ink-2); border-bottom-color: var(--color-ink-2); }
  .wm-popup strong { display: block; font-family: var(--font-display); font-size: var(--text-sm); margin-bottom: 0.2rem; }
  .wm-pop__loc { display: block; color: var(--color-paper-soft); font-size: var(--text-xs); }
  .wm-pop__type { display: block; color: var(--color-muted); font-size: var(--text-xs); margin-top: 0.15rem; }
  .wm-pop__link { display: inline-block; margin-top: 0.5rem; color: var(--color-field-bright); font-size: var(--text-xs); text-decoration: none; }
  .wm-pop__link:hover { text-decoration: underline; }

  /* keep MapLibre controls in the theme */
  .wm .maplibregl-ctrl-group { background: var(--color-ink-2); border: 1px solid var(--color-line); }
  .wm .maplibregl-ctrl-group button + button { border-top: 1px solid var(--color-line); }
  html[data-theme="dark"] .wm .maplibregl-ctrl button .maplibregl-ctrl-icon,
  html:not([data-theme="light"]) .wm .maplibregl-ctrl button .maplibregl-ctrl-icon { filter: invert(1); }
</style>
