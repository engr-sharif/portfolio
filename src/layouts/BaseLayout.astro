---
import '../styles/global.css';
// Self-hosted variable fonts. Archivo carries the width axis the opening
// animates; Newsreader is the reading face; Plex Mono is for data only.
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource-variable/newsreader/wght.css';
import '@fontsource-variable/newsreader/wght-italic.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import archivoUrl from '@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url';
import newsreaderUrl from '@fontsource-variable/newsreader/files/newsreader-latin-wght-normal.woff2?url';
import { createHash } from 'node:crypto';
import Nav from '../components/site/Nav.astro';
import Footer from '../components/site/Footer.astro';
import Rail from '../components/site/Rail.astro';
import Search from '../components/site/Search.astro';
import { withBase } from '../lib/path';
import { site } from '../lib/site';
import { IS_PREVIEW, SHOW_UNPUBLISHED } from '../lib/build-env';

export interface Props {
  title?: string;
  description?: string;
  /** Social image: base-relative ("/og/home.png") or absolute. */
  image?: string;
  ogType?: string;
  /** Draw the depth rail from this page's [data-stratum] sections. */
  rail?: boolean;
  railLabel?: string;
  /** Extra class on <body>. */
  bodyClass?: string;
  noindex?: boolean;
}

/** The generated share card for the current route (src/pages/og/). */
function ogFor(pathname: string): string {
  const base = import.meta.env.BASE_URL.replace(/\/$/, '');
  const path = pathname.startsWith(base) ? pathname.slice(base.length) : pathname;
  const parts = path.split('/').filter(Boolean);
  if (parts.length === 0) return '/og/home.png';
  const [section, slug, ...rest] = parts;
  if (['about', 'projects', 'tools', 'notes', 'cv'].includes(section)) {
    if (!slug) return `/og/${section}.png`;
    if (['projects', 'tools', 'notes'].includes(section) && rest.length === 0) return `/og/${section}/${slug}.png`;
    return `/og/${section}.png`;
  }
  return '/og/home.png';
}

const {
  title = site.seoTitle?.trim() || `${site.name} — Environmental Engineer, EIT`,
  description = site.seoDescription?.trim() || site.bio,
  image = site.ogImage?.trim() || ogFor(Astro.url.pathname),
  ogType = 'website',
  rail = false,
  railLabel,
  bodyClass = '',
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = /^https?:\/\//.test(image) ? image : new URL(withBase(image), Astro.site).href;
// Preview deployments (any branch but main on Cloudflare Pages) stay out of
// search engines: they exist for review, not for readers.
const isPreview = IS_PREVIEW;

const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: 'Environmental Engineer',
  hasCredential: 'Engineer-in-Training (EIT), California',
  description: site.bio,
  worksFor: { '@type': 'Organization', name: 'Jacobs' },
  address: { '@type': 'PostalAddress', addressLocality: 'Sacramento', addressRegion: 'CA', addressCountry: 'US' },
  url: Astro.site?.href,
  email: `mailto:${site.email}`,
  sameAs: [site.linkedin, site.github].filter(Boolean),
  knowsAbout: ['Environmental site characterization', 'Remediation', 'PFAS', 'Mercury', 'Landfill monitoring', 'XRF', 'Groundwater sampling'],
};

const goatcounter = site.analytics?.trim();

/* CSP — the baseline is in astro.config.mjs; the public site adds only:
 *  - the hash of the one inline script (theme + js gate, must run pre-paint);
 *  - style-src-attr for a few static style="" attributes (custom properties);
 *  - EnviroStor (live regulatory badge), Web3Forms (contact),
 *    YouTube thumbnails + privacy-enhanced player (click-to-load only),
 *    GoatCounter only when analytics is on. */
const JS_GATE =
  "(function(){var d=document.documentElement;d.classList.add('js');" +
  "try{var t=localStorage.getItem('theme');if(t!=='light'&&t!=='dark'){t=matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light'}" +
  "d.dataset.theme=t}catch(e){d.dataset.theme='light'}})();";
const jsGateHash = `sha256-${createHash('sha256').update(JS_GATE).digest('base64')}` as const;
type Directive = Parameters<NonNullable<typeof Astro.csp>['insertDirective']>[0];
const directive = (d: string) => Astro.csp?.insertDirective(d as Directive);
if (Astro.csp) {
  Astro.csp.insertScriptHash(jsGateHash);
  directive("style-src-attr 'unsafe-inline'");
  directive("connect-src 'self' https://services3.arcgis.com https://api.web3forms.com" + (goatcounter ? ' https://*.goatcounter.com' : ''));
  directive("img-src 'self' data: blob: https://i.ytimg.com" + (goatcounter ? ' https://*.goatcounter.com' : ''));
  directive('frame-src https://www.youtube-nocookie.com');
  directive("form-action 'self' https://api.web3forms.com");
  if (goatcounter) Astro.csp.insertScriptResource('https://gc.zgo.at');
}
---
<!doctype html>
<html lang="en" data-goatcounter={goatcounter || undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <script is:inline set:html={JS_GATE} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {(noindex || isPreview) && <meta name="robots" content="noindex, nofollow" />}
    <link rel="preload" href={archivoUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={newsreaderUrl} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <meta name="theme-color" content="#edede7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#111311" media="(prefers-color-scheme: dark)" />
    <meta name="author" content={site.name} />
    <meta name="generator" content={Astro.generator} />
    <link rel="alternate" type="application/rss+xml" title={`${site.name} — Notes`} href={new URL(withBase('/rss.xml'), Astro.site).href} />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name}, Environmental Engineer`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(personLd)} />
    <slot name="head" />
  </head>
  <body class:list={[rail && 'has-rail', bodyClass]}>
    <a class="skip" href="#main">Skip to content</a>
    <Nav />
    {rail && <Rail label={railLabel} />}
    <div class="page">
      <main id="main" tabindex="-1">
        <slot />
      </main>
      <Footer />
    </div>
    {SHOW_UNPUBLISHED && (
      <p class="stamp" role="note"><span class="stamp__k">Unlisted preview</span> Drafts are shown. Not the live site.</p>
    )}
    <Search />
    <script>
      import '../scripts/site';
    </script>
    {goatcounter && <script>import '../scripts/analytics';</script>}
  </body>
</html>
