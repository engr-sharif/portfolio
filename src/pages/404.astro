---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/path';
---
<BaseLayout title="Refusal — Mohammad Sharif" description="This page doesn't exist." noindex>
  <div class="wrap nf">
    <p class="mono nf__depth">Refusal at 404 ft bgs</p>
    <h1 class="nf__title">Refusal.</h1>
    <p class="lede">In drilling, refusal is where the auger can’t go any deeper. There’s nothing at this address.</p>
    <div class="nf__actions">
      <a class="btn" href={withBase('/')}>Back to the surface</a>
      <a class="btn btn--line" href={withBase('/projects/')}>See the work</a>
      <button class="btn btn--line" type="button" data-search-open>Search the site</button>
    </div>
  </div>
</BaseLayout>

<style>
  .nf { padding-block: clamp(4rem, 3rem + 8vw, 10rem) 0; display: grid; gap: var(--s-6); }
  .nf__depth { color: var(--cinnabar-ink); }
  .nf__title { font-size: var(--t-display); font-weight: 500; letter-spacing: -0.045em; line-height: 0.9; }
  .nf__actions { display: flex; flex-wrap: wrap; gap: var(--s-3); }
</style>
