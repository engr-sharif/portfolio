---
import { render } from 'astro:content';
import { Code } from 'astro-expressive-code/components';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TitleBlock from '../../components/ui/TitleBlock.astro';
import Figure from '../../components/ui/Figure.astro';
import Schematic from '../../components/tools/Schematic.astro';
import Loop from '../../components/media/Loop.astro';
import YouTube from '../../components/media/YouTube.astro';
import { getTools } from '../../lib/tools';
import { getImage } from '../../lib/images';
import { withBase } from '../../lib/path';

export async function getStaticPaths() {
  const tools = await getTools();
  return tools.map((tool, i) => ({ params: { slug: tool.id }, props: { tool, i, prev: tools[i - 1] ?? null, next: tools[i + 1] ?? null } }));
}
const { tool, i, prev, next } = Astro.props;
const d = tool.data;
const { Content } = await render(tool);
const shots = d.screenshots.map((s) => getImage(s)).filter((x): x is NonNullable<typeof x> => !!x);
const no = `T-${String(i + 1).padStart(2, '0')}`;
---
<BaseLayout title={`${d.name} — Mohammad Sharif`} description={d.summary} ogType="article">
  <article class="wrap tool">
    <header class="phead">
      <ol class="phead__crumbs"><li><a href={withBase('/')}>Home</a></li><li><a href={withBase('/tools/')}>Tools</a></li><li aria-current="page">{d.name}</li></ol>
      <p class="mono tool__no">{no}</p>
      <h1 class="phead__title">{d.name}</h1>
      <p class="lede phead__lede">{d.summary}</p>
      <div class="tool__tb"><TitleBlock wideCols={3} cells={[
        { label: 'Built with', value: d.tech.join(', ') },
        { label: 'Source', value: d.repoUrl ? d.repoUrl.replace(/^https:\/\/github\.com\//, 'github.com/') : 'On request' },
        { label: 'Try it', value: d.liveUrl ? d.liveUrl.replace(/^https?:\/\//, '') : 'On request' },
      ]} /></div>
    </header>

    <figure class="fig tool__fig">
      <div class="fig__frame tool__frame" style={`view-transition-name: tool-${tool.id}`}>
        {d.loop ? <Loop src={d.loop} poster={d.loopPoster} label={`${d.name}, screen recording`} /> : <div class="tool__sch"><Schematic slug={tool.id} label={`Schematic: ${d.summary}`} /></div>}
      </div>
      <figcaption class="fig__cap"><span class="fig__no">Fig. 1</span><span>{d.loop ? 'Screen recording.' : 'What it does, drawn as a schematic. No project data is shown.'}</span></figcaption>
    </figure>

    <div class="tool__body">
      <aside class="tool__aside">
        {d.problem && <div><p class="label">The problem</p><p class="tool__prob">{d.problem}</p></div>}
        <div class="tool__actions">
          {d.liveUrl && <a class="btn" href={d.liveUrl} rel="noopener">Open the tool <span class="arrow" aria-hidden="true">↗</span></a>}
          {d.repoUrl && <a class="btn btn--line" href={d.repoUrl} rel="noopener">Source on GitHub <span class="arrow" aria-hidden="true">↗</span></a>}
        </div>
      </aside>
      <div class="tool__main">
        <div class="prose"><Content /></div>
        {d.codeSnippet && (
          <section class="tool__code" aria-label="Code excerpt">
            <p class="label">Excerpt</p>
            <Code code={d.codeSnippet} lang={d.codeLang} />
          </section>
        )}
        {d.video && <div class="tool__video"><YouTube video={d.video} title={`${d.name}: walkthrough`} /></div>}
      </div>
    </div>

    {shots.length > 0 && (
      <section class="tool__shots" aria-label="Screenshots">
        {shots.map((s, k) => <Figure image={s} alt={`${d.name}, screenshot ${k + 1}`} no={String(k + 2)} group="tool" sizes="(min-width: 64rem) 45vw, 92vw" />)}
      </section>
    )}

    <nav class="pager tool__pager" aria-label="More tools">
      {prev && <a href={withBase(`/tools/${prev.id}/`)}><span class="label">← Previous</span><span class="t">{prev.data.name}</span></a>}
      {next && <a href={withBase(`/tools/${next.id}/`)}><span class="label">Next →</span><span class="t">{next.data.name}</span></a>}
    </nav>
  </article>
</BaseLayout>

<style>
  .tool__no { color: var(--cinnabar-ink); margin-bottom: var(--s-4); }
  .tool__tb { margin-top: var(--s-7); }
  .tool__fig { margin-top: var(--s-7); max-width: 60rem; }
  .tool__frame { aspect-ratio: 16 / 9; background: var(--ground-2); }
  .tool__sch { padding: 5% 12% 6%; height: 100%; display: grid; place-items: center; }
  .tool__sch :global(svg) { max-height: 100%; }
  .tool__body { display: grid; gap: var(--s-7); margin-top: clamp(3.5rem, 2.5rem + 3vw, 6rem); }
  .tool__aside { display: grid; gap: var(--s-6); align-content: start; }
  .tool__prob { font-family: var(--f-text); font-size: 1.125rem; line-height: 1.55; margin-top: var(--s-2); }
  .tool__actions { display: flex; flex-wrap: wrap; gap: var(--s-3); }
  .tool__code { margin-top: var(--s-8); max-width: calc(var(--measure) + 6rem); display: grid; gap: var(--s-3); }
  .tool__video { margin-top: var(--s-7); max-width: var(--measure); }
  .tool__shots { display: grid; gap: var(--s-7) var(--gap); margin-top: var(--section); }
  @media (min-width: 64rem) {
    .tool__body { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gap); }
    .tool__aside { grid-column: 1 / span 3; position: sticky; top: calc(var(--nav-h) + var(--s-6)); }
    .tool__main { grid-column: 5 / span 8; }
    .tool__shots { grid-template-columns: 1fr 1fr; }
  }
  .tool__pager { margin-top: var(--section); }
</style>
