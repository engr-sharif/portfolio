---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import FieldAtlas from '../components/FieldAtlas.astro';
import CaseStudies from '../components/CaseStudies.astro';
import Stats from '../components/Stats.astro';
import Tools from '../components/Tools.astro';
import Gallery from '../components/Gallery.astro';
import LatestWriting from '../components/LatestWriting.astro';
import Contact from '../components/Contact.astro';
import TopoDivider from '../components/atlas/TopoDivider.astro';
---

<BaseLayout>
  {/* Act 1 — arrival */}
  <Hero />

  {/* Act 2 — the atlas: every site on the map, the index of the work */}
  <FieldAtlas />

  {/* Act 3 — the proof: case studies read like a report, then the numbers */}
  <CaseStudies />
  <Stats />

  <div class="u-container"><TopoDivider /></div>

  {/* Act 4 — the differentiator: an engineer who ships software */}
  <Tools />

  <div class="u-container"><TopoDivider /></div>

  {/* Act 5 — from the field */}
  <Gallery />

  {/* Act 6 — the writing */}
  <LatestWriting />

  {/* Act 7 — the ask */}
  <Contact />
</BaseLayout>
