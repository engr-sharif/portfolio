---
import Studio from '../../studio/Studio.tsx';
import '../../studio/studio.css';
import { site } from '../../lib/site';
import { withBase } from '../../lib/path';

// Content-Security-Policy for the admin, on top of the site-wide baseline in
// astro.config.mjs (Astro hashes its own island scripts). The Studio talks to
// exactly three origins: its Cloudflare Worker (API + AI), GitHub's raw
// content (media previews) and GitHub's REST API (deploy status). Anything
// else — inline handlers, third-party scripts, form posts elsewhere — is
// refused by the browser, containing the blast radius of injected markdown
// or a compromised dependency.
Astro.csp?.insertDirective("connect-src 'self' https://*.workers.dev https://api.github.com https://raw.githubusercontent.com");
Astro.csp?.insertDirective("img-src 'self' data: blob: https://raw.githubusercontent.com");
Astro.csp?.insertDirective("media-src 'self' blob: https://raw.githubusercontent.com");
Astro.csp?.insertDirective('frame-src https://www.youtube-nocookie.com https://player.vimeo.com');
Astro.csp?.insertDirective("form-action 'self'");
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="referrer" content="no-referrer" />
    <title>Studio — {site.name}</title>
    <link rel="icon" href={withBase('favicon.svg')} type="image/svg+xml" />
  </head>
  <body>
    <div id="studio-root">
      <Studio client:only="react" />
    </div>
    <noscript>The Studio admin requires JavaScript.</noscript>
  </body>
</html>
