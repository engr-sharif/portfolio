---
import Studio from '../../studio/Studio.tsx';
import '../../studio/studio.css';
import { site } from '../../lib/site';

// Content Security Policy for the admin. The Studio talks to exactly three
// origins: its Cloudflare Worker (API + AI), GitHub's raw content (media
// previews) and GitHub's REST API (deploy status). Everything else — inline
// event handlers, third-party scripts, form posts elsewhere — is refused by
// the browser, which contains the blast radius of any injected markdown or a
// compromised dependency. Astro's two inline island-bootstrap scripts are
// allowed by hash; integrations/studio-csp.mjs fills the placeholder after the
// build so the policy survives Astro upgrades. Production only — the dev
// server has no build step to compute hashes.
const csp = import.meta.env.PROD ? [
  "default-src 'self'",
  "script-src 'self' __STUDIO_SCRIPT_HASHES__",
  "style-src 'self' 'unsafe-inline'",
  "img-src 'self' data: blob: https://raw.githubusercontent.com",
  "media-src 'self' blob: https://raw.githubusercontent.com",
  "font-src 'self' data:",
  "connect-src 'self' https://*.workers.dev https://api.github.com https://raw.githubusercontent.com",
  "frame-src https://www.youtube-nocookie.com https://player.vimeo.com",
  "worker-src 'self' blob:",
  "object-src 'none'",
  "base-uri 'self'",
  "form-action 'self'",
  "frame-ancestors 'none'",
].join('; ') : '';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    {csp && <meta http-equiv="Content-Security-Policy" content={csp} />}
    <meta name="referrer" content="no-referrer" />
    <title>Studio — {site.name}</title>
    <link rel="icon" href="/portfolio/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <div id="studio-root">
      <Studio client:only="react" />
    </div>
    <noscript>The Studio admin requires JavaScript.</noscript>
  </body>
</html>
